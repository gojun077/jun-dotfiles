<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.peterjunkoh.remove-tailscale-app.plist

  System LaunchDaemon that periodically removes /Applications/Tailscale.app
  (reinstalled by corporate MDM ~every 30 min) so the open-source tailscale
  CLI stays the active client.

  Runs as root (LaunchDaemon) because the MDM-installed bundle is owned by
  root and cannot be removed by a user LaunchAgent without a password prompt.

  Install (one-time, run with sudo):
    cp ~/dotfiles/macOS/com.peterjunkoh.remove-tailscale-app.plist /Library/LaunchDaemons/
    chown root:wheel /Library/LaunchDaemons/com.peterjunkoh.remove-tailscale-app.plist
    chmod +x ~/dotfiles/macOS/remove_tailscale_app.sh
    launchctl load -w /Library/LaunchDaemons/com.peterjunkoh.remove-tailscale-app.plist

  Uninstall:
    launchctl unload -w /Library/LaunchDaemons/com.peterjunkoh.remove-tailscale-app.plist
    rm -f /Library/LaunchDaemons/com.peterjunkoh.remove-tailscale-app.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.peterjunkoh.remove-tailscale-app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/peter.junkoh/dotfiles/macOS/remove_tailscale_app.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardErrorPath</key>
  <string>/var/log/remove-tailscale-app.log</string>
</dict>
</plist>
