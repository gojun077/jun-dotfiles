    "sway/window": {
        "format": {},
        "spacing": 8
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "🔒",
            "unlocked": "🔓"
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
